<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Splitly.Mobile.Pages.ReceiptPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:Splitly.Contracts;assembly=Splitly.Contracts"
             Title="Receipt">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label x:Name="StatusLabel" FontAttributes="Bold" FontSize="16" AutomationId="status" />
            <Label x:Name="NoteLabel" TextColor="#B42318" IsVisible="False" />

            <VerticalStackLayout x:Name="ItemsPanel" Spacing="0" AutomationId="items">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="dto:ReceiptItemDto">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{Binding Description}" FontAttributes="Bold" />
                                <Label FontSize="12" TextColor="#B54708" IsVisible="{Binding NeedsReview}"
                                       Text="Needs a check: edit it on the website." />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:N2}'}" VerticalOptions="Center" />
                            <Switch Grid.Column="2" Toggled="OnClaimToggled" AutomationId="claim" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label x:Name="HintLabel" FontSize="12" TextColor="{AppThemeBinding Light=#667085, Dark=#98A2B3}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
