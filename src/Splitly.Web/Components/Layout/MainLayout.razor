@inherits LayoutComponentBase
@implements IDisposable
@inject Splitly.Web.Services.ApiClient Api
@inject NavigationManager Nav

<header class="topbar">
    <a class="brand" href="/groups">Splitly</a>
    @if (Api.IsSignedIn)
    {
        <a class="who" href="/account" id="account-link">@Api.Me!.DisplayName</a>
        <button class="link" id="logout" @onclick="LogOut">Sign out</button>
    }
</header>

<main class="page">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => Api.SessionChanged += OnSessionChanged;
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Api.SessionChanged -= OnSessionChanged;

    private async Task LogOut()
    {
        await Api.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
